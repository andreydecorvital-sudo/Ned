# Banco PostgreSQL serverless (Neon/Vercel Marketplace)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Acesso aos painéis /admin/leads, /admin/conteudo e /admin/viral
NED_ADMIN_PASSWORD=troque-por-uma-senha-forte

# URL pública de produção, sem barra final
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Vercel Blob público para imagens, vídeos e capas
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Gemini para legendas, ganchos, CTAs e hashtags na NED Viral Machine
# Sem a chave, o painel continua funcionando em modo local.
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash

# Meta / Instagram Graph API (conta profissional conectada por Facebook Login)
# Permissões recomendadas: instagram_basic, instagram_content_publish,
# pages_show_list, pages_read_engagement e instagram_manage_comments.
META_GRAPH_API_VERSION=vXX.X
INSTAGRAM_BUSINESS_ACCOUNT_ID=1784...
INSTAGRAM_ACCESS_TOKEN=EAAB...

# Upstash QStash para disparar cada publicação no horário definido
QSTASH_TOKEN=ey...
SOCIAL_PUBLISH_SECRET=gere-um-segredo-longo-e-aleatorio
